# ============================================================
# PROYECTO: Sistema de Analítica Conversacional - Real Córdova
# ARCHIVO:  .env.example
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env
#   2. Completar los valores según tu instalación local
#   3. NUNCA subir el .env al repositorio GitHub
# ============================================================

# ── PostgreSQL 17 (instalación local) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_cordova_db
DB_USER=postgres
DB_PASS=tu_password_aqui

# ── Ollama (servidor local de inferencia) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ── FastAPI ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Streamlit ──────────────────────────────────────────────
STREAMLIT_PORT=8501

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs/
