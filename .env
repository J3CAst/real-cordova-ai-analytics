# ── PostgreSQL 17 (instalación local) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_cordova_db
DB_USER=postgres
DB_PASS=Peluchin125$

# ── Ollama (servidor local de inferencia) ──────────────────
OLLAMA_HOST=127.0.0.1:11435
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ── FastAPI ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=true

# ── Streamlit ──────────────────────────────────────────────
STREAMLIT_PORT=8501

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs/

# ── Seguridad API ──────────────────────────────────────────
# Clave requerida en header X-API-Key para /schema y /export/logs
# Si se deja vacío, esos endpoints quedan abiertos (solo para desarrollo)
API_KEY=real-cordova-clave-secreta-2026